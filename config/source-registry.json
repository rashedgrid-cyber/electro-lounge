{
  "project": "Electro Lounge",
  "version": "3.0",

  "global_rules": {
    "publishing_language": "English",
    "translate_arabic_to_english": true,
    "human_approval_required": true,
    "auto_publish": false,
    "copyright_safe_original_content": true,
    "technical_market_scope": "GLOBAL",
    "business_market_scope": "GLOBAL",
    "preserve_source_url_internally": true,
    "use_real_electro_lounge_logo": true,
    "use_real_relevant_company_logo": true,
    "generate_original_topic_representation": true
  },

  "direct_rss_sources": [
    {
      "id": "RSS001",
      "name": "Transformer Magazine",
      "scope": "GLOBAL",
      "type": "rss",
      "url": "https://www.transformers-magazine.com/feed/",
      "priority": "high",
      "enabled": true
    }
  ],

  "watchers": [
    {
      "id": "W01",
      "name": "Technical RSS and News Radar",
      "scope": "GLOBAL",
      "outputs": ["TECHNICAL_POST"],
      "prefer_direct_rss": true,
      "existing_system": true,
      "existing_config": "config/rss-sources.json",
      "enabled": true
    },

    {
      "id": "W02",
      "name": "Tender RFQ and Project Radar",
      "scope": "GLOBAL",
